{
  "name": "inclusive-access",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "demo": "node tools/serve-demo.mjs",
    "test": "node --test tests/core.test.js tests/voice.test.js tests/api.test.js",
    "test:unit": "node --test tests/core.test.js tests/voice.test.js",
    "test:voice": "node --test tests/voice.test.js",
    "test:api": "node --test tests/api.test.js",
    "test:a11y": "playwright test",
    "test:all": "npm test && npm run test:a11y",
    "contrast": "node tools/contrast-check.mjs",
    "recording": "node tools/make-recording-script.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/noto-sans-ethiopic": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@playwright/test": "^1.65.1"
  },
  "description": "Accessible onboarding and career gateway plug-in (Web Component, REST API, LTI 1.3) for Ethiopian learners",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
