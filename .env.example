# Copy to .env and fill in what you need. Every setting is optional for a local demo. Never commit a real .env.
# docker compose passes PUBLIC_URL, ALLOWED_ORIGINS, ADMIN_TOKEN and APP_SECRET from .env; without Docker, export them before `npm start`.

# Port the server listens on (Render and similar hosts set this themselves).
PORT=3000
# The public address people use, with https in production. Used in LTI, JobPosting and the API docs.
# On Render this is found automatically (RENDER_EXTERNAL_URL); leave it empty there.
PUBLIC_URL=http://localhost:3000
# Sites allowed to embed the plug-in, comma-separated. Empty = any site (fine for a demo).
ALLOWED_ORIGINS=
# Protects GET /v1/consents (the consent log). Empty = open (demo only). Use a long random value.
ADMIN_TOKEN=
# Secret for receipt codes and LTI state. Empty = a new random one at each start (receipts stop working after a restart).
APP_SECRET=

# LTI 1.3: only to register a real learning platform (Moodle, Canvas, Savanna). Leave empty to use the built-in demo LMS.
LTI_ISSUER=
LTI_CLIENT_ID=
LTI_AUTH_URL=
LTI_JWKS_URL=
LTI_DEPLOYMENT_ID=
# Set to "off" to hide the built-in demo LMS at /demo/lms in production.
DEMO_LMS=
